# SceneWeave 配置模板
#
# 用法：复制为 .env 后填入真实值。
#   cp .env.example .env            # 推荐：放在仓库根目录
#
# 已放置的路径（两者同时存在时，**backend/.env 覆盖仓库根 .env**，实测结论）：
#   1. <仓库根>/.env        ← 优先读取，推荐使用
#   2. <仓库根>/backend/.env  ← 后加载，会覆盖上面那份
# 为避免混淆，建议只保留一处（默认模板放在仓库根）。
#
# 优先级（高 → 低）：代码显式传入 > 环境变量 > .env > 默认值。
# .env 已被 .gitignore 忽略；请勿提交，也不要把密钥写进代码或文档。
# 测试一律以 _env_file=None 构造配置，因此本文件不会被测试读取。

# 模型凭证（唯一密钥入口）。留空则使用确定性 Mock，不发起任何真实调用。
SCENEWEAVE_MODEL_API_KEY=

# 模型提供方：auto（默认：有密钥走 DeepSeek，否则用确定性 Mock）／mock／deepseek／local
# SCENEWEAVE_MODEL_PROVIDER=auto

# 运行模型名（与开发执行模型分离）
SCENEWEAVE_MODEL_NAME=deepseek-flash

# ── 接入本地模型（Ollama／LM Studio／vLLM／llama.cpp）────────────────────
# 本地服务**不需要密钥**：用 local 提供方时请把上面的 API_KEY 留空。
# 只需把下面三行取消注释并按实际服务改写：
#   SCENEWEAVE_MODEL_PROVIDER=local
#   SCENEWEAVE_MODEL_BASE_URL=http://127.0.0.1:11434/v1     # Ollama
#                                                            # LM Studio: http://127.0.0.1:1234/v1
#                                                            # vLLM:      http://127.0.0.1:8000/v1
#                                                            # llama.cpp: http://127.0.0.1:8080/v1
#   SCENEWEAVE_MODEL_NAME=qwen2.5:7b
# 部分本地实现的 JSON 模式支持不完整时，可关闭 response_format（仍由提示词约束 JSON）
#   SCENEWEAVE_LOCAL_INCLUDE_RESPONSE_FORMAT=false

# 可选：自建网关或代理时的基地址
# SCENEWEAVE_MODEL_BASE_URL=https://api.deepseek.com

# 可选：强制使用确定性 Mock（演示/测试），即使配置了密钥也不联网
# SCENEWEAVE_MODEL_FORCE_MOCK=false

# 可选：行为分析能力（需要额外安装外部分析仓库）
# SCENEWEAVE_ANALYSIS_ENABLED=false

# 可选：SQLite 路径
# SCENEWEAVE_DATABASE_URL=sqlite:///./sceneweave.db

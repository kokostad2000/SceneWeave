      "provider_request_id": "7691d42a-8bbf-4e1f-94c4-070df8babbd1",
      "input_tokens": 1156,
      "output_tokens": 73,
      "cached_tokens": 512,
      "usage_unknown": 0,
      "failure_kind": null,
      "sent": 1,
      "budget_consumed": 1,

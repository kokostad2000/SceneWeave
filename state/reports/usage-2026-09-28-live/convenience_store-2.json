      "action_id": "act_511808c6b5ba4fb397daad6c110a9fe9",
      "actor_id": "agt_049296ada8fd46699cdf4ff413056752",
      "status": "SUCCEEDED",
      "action": "SPEAK",
      "text": "谢了，雨衣我拿上。回头还回来。",
      "reply_to_message_id": "msg_24802be1df334d05be9c1f2d1b181c07",
      "requested_speaker_id": null,
      "input_cursor_seq": 9,
      "prompt_template_id": "role_action@m02.1",
      "requested_model": "deepseek-flash",
      "returned_model": "deepseek-flash",

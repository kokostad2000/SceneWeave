      "action_id": "act_a5342126992b4b81bc52aadca66d520d",
      "actor_id": "agt_01f0c16757c24508b22ed478320b731a",
      "status": "SUCCEEDED",
      "action": "SPEAK",
      "text": "雨衣不用急着还。末班车快到了，跑吧。",
      "reply_to_message_id": "msg_e291ac0c72fa4ce794a594ea83c366a9",
      "requested_speaker_id": null,
      "input_cursor_seq": 10,
      "prompt_template_id": "role_action@m02.1",
      "requested_model": "deepseek-flash",
      "returned_model": "deepseek-flash",

      "action_id": "act_228a402515d04e47bb2cd6cbdb79812b",
      "actor_id": "agt_45e3bb2c464d44c8b5ca9a6473c07315",
      "status": "SUCCEEDED",
      "action": "SPEAK",
      "text": "行，黑着也挺好，正好歇会儿。你们聊你们的，我靠着眯一下。",
      "reply_to_message_id": "msg_dbd9e0eb8bd746b3bf65e0c0b72a557b",
      "requested_speaker_id": null,
      "input_cursor_seq": 9,
      "prompt_template_id": "role_action@m02.1",
      "requested_model": "deepseek-flash",
      "returned_model": "deepseek-flash",
      "provider_request_id": "e36fdc62-0cdd-446a-8d20-e5cb87baafa8",
      "input_tokens": 1004,
      "output_tokens": 74,
      "cached_tokens": 256,
      "usage_unknown": 0,
      "failure_kind": null,
      "sent": 1,
      "budget_consumed": 1,
      "latency_ms": 1204,
      "created_at": "2026-09-28T02:19:29.368728+00:00",

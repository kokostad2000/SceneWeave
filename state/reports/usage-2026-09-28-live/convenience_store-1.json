      "actor_id": "agt_23787d5d80b248e49b699f2174fec8ff",
      "status": "SUCCEEDED",
      "action": "SPEAK",
      "text": "嗯，避雨。等车。",
      "reply_to_message_id": "msg_033b0ffb2fde44a785ecb774efbc025c",
      "requested_speaker_id": null,
      "input_cursor_seq": 2,
      "prompt_template_id": "role_action@m02.1",
      "requested_model": "deepseek-flash",
      "returned_model": "deepseek-flash",

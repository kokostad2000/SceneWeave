      "actor_id": "agt_6d89b564d4264557ade90c4ee4adad1a",
      "status": "SUCCEEDED",
      "action": "SPEAK",
      "text": "哎，这雨说下就下了，一点预兆都没有。你也是来避雨的吗？我就住附近，刚搬来没多久，晚上一个人待着没事干就爱往这儿跑。",
      "reply_to_message_id": null,
      "requested_speaker_id": "agt_23787d5d80b248e49b699f2174fec8ff",
      "input_cursor_seq": 1,
      "prompt_template_id": "role_action@m02.1",
      "requested_model": "deepseek-flash",
      "returned_model": "deepseek-flash",
      "provider_request_id": "b770d89a-1063-4add-81ff-8fb32ab03d3c",
      "input_tokens": 558,
      "output_tokens": 94,
      "cached_tokens": 0,
      "usage_unknown": 0,
      "failure_kind": null,

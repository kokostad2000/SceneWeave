      "status": "SUCCEEDED",
      "action": "SPEAK",
      "text": "水，六块。雨一时半会儿停不了。",
      "reply_to_message_id": "msg_32919559cd3248f388b2495bcc21ca64",
      "requested_speaker_id": null,
      "input_cursor_seq": 3,
      "prompt_template_id": "role_action@m02.1",
      "requested_model": "deepseek-flash",

      "status": "SUCCEEDED",
      "action": "SPEAK",
      "text": "末班车还有五分钟。要买什么赶紧。",
      "reply_to_message_id": "msg_17049cd5cc1d4f408adfd70e55b0a958",
      "requested_speaker_id": null,
      "input_cursor_seq": 6,
      "prompt_template_id": "role_action@m02.1",
      "requested_model": "deepseek-flash",
      "returned_model": "deepseek-flash",

{
  "agent_count": {
    "default": 3,
    "max": 8,
    "min": 2
  },
  "app_name": "SceneWeave",
  "app_version": "0.1.0",
  "budgets": {
    "max_analysis_requests_per_scene": 4,
    "max_role_requests_per_scene": 200
  },
  "contract_version": "fc.p1.1",
  "enums": [
    {
      "name": "SceneMode",
      "values": [
        "simulation",
        "discussion"
      ]
    },
    {
      "name": "ActionType",
      "values": [
        "SPEAK",
        "PRIVATE",
        "PASS"
      ]
    },
    {
      "name": "MessageVisibility",
      "values": [
        "PUBLIC",
        "PRIVATE"
      ]
    },
    {
      "name": "EventVisibility",
      "values": [
        "ALL",
        "TARGETED"
      ]
    },
    {
      "name": "EventStatus",
      "values": [
        "ACCEPTED",
        "EFFECTIVE"
      ]
    },
    {
      "name": "RunState",
      "values": [
        "READY",
        "RUNNING",
        "PAUSING",
        "STOPPING",
        "PAUSED",
        "ENDED"
      ]
    },
    {
      "name": "PauseReason",
      "values": [
        "NO_NEW_INFORMATION",
        "COLLECTIVE_SILENCE",
        "MANUAL",
        "PROVIDER_ERROR",
        "CONTEXT_LIMIT",
        "PROCESS_INTERRUPT"
      ]
    },
    {
      "name": "ControlCommandType",
      "values": [
        "START",
        "STEP",
        "PAUSE",
        "RESUME",
        "STOP"
      ]
    },
    {
      "name": "TurnStatus",
      "values": [
        "SUCCEEDED",
        "FAILED",
        "UNKNOWN"
      ]
    },
    {
      "name": "ModelFailureKind",
      "values": [
        "EMPTY_CONTENT",
        "TRUNCATED",
        "INVALID_JSON",
        "SCHEMA_INVALID",
        "REFERENCE_INVALID",
        "TIMEOUT",
        "PROVIDER_ERROR",
        "CONTEXT_LIMIT",
        "BUDGET_EXHAUSTED",
        "MISSING_CONFIG",
        "UNKNOWN_REQUEST",
        "NOT_DISPATCHED"
      ]
    },
    {
      "name": "AnalysisStatus",
      "values": [
        "NORMAL",
        "BLOCKED",
        "DEGRADED",
        "FAILED",
        "DISABLED"
      ]
    },
    {
      "name": "SchedulerReason",
      "values": [
        "STARTUP_OPPORTUNITY",
        "NEW_VISIBLE_INFORMATION",
        "REQUESTED_SPEAKER_PRIORITY",
        "ROUND_ROBIN"
      ]
    }
  ],
  "limit_codepoints": {
    "agent_name": 30,
    "analysis_behavior_description": 4000,
    "analysis_context": 4000,
    "discussion_focus": 500,
    "event_body": 1000,
    "initial_goal": 500,
    "initial_position": 1000,
    "max_prompt_chars": 32000,
    "persona": 1000,
    "private_background": 1000,
    "public_profile": 1000,
    "scene_background": 2000,
    "speak_text": 1000,
    "speech_style": 300
  },
  "model_params": {
    "max_output_tokens": 4096,
    "min_speak_text_codepoints": 1,
    "model": "deepseek-flash",
    "request_timeout_seconds": 90,
    "sdk_max_retries": 0,
    "send_tools": false,
    "stream": false,
    "thinking_enabled": false
  },
  "ports": [
    "ModelPort",
    "AnalysisPort"
  ],
  "run_states": [
    "READY",
    "RUNNING",
    "PAUSING",
    "STOPPING",
    "PAUSED",
    "ENDED"
  ],
  "schema_version": 1
}
